#!/usr/bin/env node
// Thin shebang wrapper so Claude Code's PATH-injection can find `btrmnt`. The
// real CLI lives in src/cli.ts and is compiled to dist/cli.js.
//
// dist/ is intentionally committed (see .gitignore exception). Claude Code
// clones this repo verbatim on plugin install — there is no postinstall
// build step — so the only way to ship a working CLI is to check in the
// compiled output. The `verify-dist-fresh` CI job enforces that the
// committed dist matches src/ on every push to main.
import { fileURLToPath, pathToFileURL } from 'node:url'
import { dirname, resolve } from 'node:path'
const __dirname = dirname(fileURLToPath(import.meta.url))
// On Windows, resolve() yields a backslash path like C:\...\dist\cli.js.
// Node's ESM loader rejects that because it parses `c:` as a URL scheme
// (ERR_UNSUPPORTED_ESM_URL_SCHEME). pathToFileURL gives us a proper
// file:// URL that works on every platform.
await import(pathToFileURL(resolve(__dirname, 'dist', 'cli.js')).href)
